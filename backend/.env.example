# Copy to backend/.env and adjust as needed.

SECRET_KEY=django-insecure-dev-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Local development uses SQLite when this is left commented out.
# Switch to Postgres by uncommenting and pointing at your instance:
# DATABASE_URL=postgres://elevate:elevate@localhost:5432/elevate_cms

TIME_ZONE=Africa/Dar_es_Salaam
DEFAULT_CURRENCY=TZS

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
