# Railway deployment — copy to service variables (Dashboard → Variables)
# https://docs.railway.app/guides/variables

# Required in production
SECRET_KEY=generate-a-long-random-string
DEBUG=False

# Railway sets DATABASE_URL when you add a PostgreSQL plugin.
# DATABASE_URL=postgresql://...

# Your public hostname(s), comma-separated (no scheme).
# Railway example after first deploy:
# ALLOWED_HOSTS=your-app.up.railway.app
# Or with a custom domain:
# ALLOWED_HOSTS=app.elevatedigital.co.tz,www.app.elevatedigital.co.tz

# HTTPS — trust your Railway / custom domain for CSRF (include https://)
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app

# Optional — only if frontend and API are on different origins
# VITE_API_URL is baked in at Docker build as /api (same host). Rebuild if you split services.

TIME_ZONE=Africa/Dar_es_Salaam
DEFAULT_CURRENCY=TZS
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
LOG_LEVEL=INFO

# Gunicorn (optional)
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=120
